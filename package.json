    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.7.2"
  }

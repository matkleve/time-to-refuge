{
  "name": "time-to-refuge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "a11y:contrast": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/a11y-contrast.ts",
